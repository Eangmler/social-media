# ============================================================
# AI-Driven Social Media Management SaaS Environment Variables
# ============================================================

# Security
APP_SECRET=your_super_secret_app_key_32_chars
CRON_SECRET=your_random_vercel_cron_secret

# 1. Apify API (Web Scraping Layer)
APIFY_TOKEN=apify_api_your_token_here

# 2. AI Intelligence Layer (OpenAI or Gemini)
AI_PROVIDER=openai # Options: 'openai' or 'gemini'
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Meta Graph API (Instagram Publishing & Webhooks)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_long_lived_user_or_page_access_token
META_PAGE_ID=your_facebook_page_id
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_WEBHOOK_VERIFY_TOKEN=your_custom_meta_webhook_verify_token

# 4. TikTok Content Posting & Business API
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_creator_access_token
TIKTOK_OPEN_ID=your_tiktok_user_open_id
TIKTOK_WEBHOOK_VERIFY_TOKEN=your_custom_tiktok_webhook_token

# 5. DM Automation Defaults
DM_DEFAULT_TRIGGER_KEYWORD=LINK
DM_DEFAULT_RESPONSE_TEMPLATE=Hey there! Thanks for your comment. Here is the private link you requested: {{link}}
DM_DEFAULT_TARGET_URL=https://yourbrand.com/special-offer

# Base URL (used for webhooks and public video delivery)
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app
